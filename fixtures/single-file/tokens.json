{
  "core": {
    "color": {
      "ink": { "value": "#182230", "type": "color" },
      "paper": { "value": "#ffffff", "type": "color" },
      "brand": { "value": "#5265ed", "type": "color" }
    },
    "space": {
      "small": { "value": "8px", "type": "spacing" },
      "medium": { "value": "{space.small} * 2", "type": "spacing" }
    },
    "font": {
      "family": { "value": "Inter", "type": "fontFamily" },
      "regular": { "value": "Regular", "type": "fontWeight" },
      "size": { "value": "16px", "type": "fontSize" },
      "leading": { "value": "24px", "type": "lineHeight" }
    },
    "radius": { "value": "8px", "type": "borderRadius" },
    "enabled": { "value": true, "type": "boolean" },
    "opacity": { "value": "80%", "type": "opacity" }
  },
  "themes/light": {
    "surface": { "value": "{color.paper}", "type": "color" },
    "text": { "value": "{color.ink}", "type": "color" },
    "shadowColor": { "value": "#18223024", "type": "color" }
  },
  "themes/dark": {
    "surface": { "value": "{color.ink}", "type": "color" },
    "text": { "value": "{color.paper}", "type": "color" },
    "shadowColor": { "value": "#00000066", "type": "color" }
  },
  "components": {
    "body": {
      "type": "typography",
      "value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.regular}",
        "fontSize": "{font.size}",
        "lineHeight": "{font.leading}",
        "letterSpacing": "0px",
        "paragraphSpacing": "8px",
        "textCase": "none",
        "textDecoration": "none"
      }
    },
    "elevation": {
      "type": "boxShadow",
      "value": [
        {
          "x": "0px",
          "y": "2px",
          "blur": "8px",
          "spread": "0px",
          "color": "{shadowColor}",
          "type": "dropShadow"
        },
        {
          "x": "0px",
          "y": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "#00000010",
          "type": "innerShadow"
        }
      ]
    },
    "hero": {
      "type": "color",
      "value": "linear-gradient(90deg, {color.brand} 0%, {surface} 100%)"
    },
    "soften": { "type": "blur", "value": "12px" },
    "outline": {
      "type": "border",
      "value": { "color": "{text}", "width": "1px", "style": "solid" }
    }
  },
  "$themes": [
    {
      "id": "core",
      "name": "Default",
      "group": "Foundations",
      "selectedTokenSets": { "core": "enabled" }
    },
    {
      "id": "light",
      "name": "Light",
      "group": "Interface",
      "selectedTokenSets": {
        "core": "source",
        "themes/light": "enabled",
        "themes/dark": "disabled",
        "components": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "Dark",
      "group": "Interface",
      "selectedTokenSets": {
        "core": "source",
        "themes/light": "disabled",
        "themes/dark": "enabled",
        "components": "enabled"
      }
    }
  ],
  "$metadata": { "tokenSetOrder": ["core", "themes/light", "themes/dark", "components"] }
}
