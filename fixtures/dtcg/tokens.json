{
  "palette": {
    "$type": "color",
    "blue": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8], "alpha": 1 } }
  },
  "space": { "$type": "dimension", "base": { "$value": { "value": 1, "unit": "rem" } } },
  "heading": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Inter",
      "fontWeight": 700,
      "fontSize": { "value": 2, "unit": "rem" },
      "lineHeight": 1.25,
      "letterSpacing": { "value": 0, "unit": "px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$value": {
      "color": "{palette.blue}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 4, "unit": "px" },
      "blur": { "value": 8, "unit": "px" },
      "spread": { "value": 0, "unit": "px" },
      "inset": false
    }
  },
  "gradient": {
    "$type": "gradient",
    "$value": [
      { "color": "{palette.blue}", "position": 0 },
      { "color": { "colorSpace": "srgb", "components": [1, 1, 1] }, "position": 1 }
    ]
  }
}
